# Copy to .env for local runs (`npm run dev` loads it). Never commit real values.
# On Render these live in the service's environment, not in a file.

HOST=0.0.0.0
PORT=10000
LOG_LEVEL=info

# M0. The external cron sends "Authorization: Bearer <value>". At least 32 characters.
CRON_SHARED_SECRET=

# M1
PLACEMENT_STUDENT_ID=
PLACEMENT_PASSWORD=
SUPABASE_URL=
# Legacy service_role JWT or an sb_secret_ key. Server side only.
SUPABASE_SERVICE_ROLE_KEY=

# M3
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# At least 32 characters. Sent as Telegram setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# M4
NOTION_TOKEN=
NOTION_DATABASE_ID=

# M5 / M11 / M12 — PESU: gmail.readonly. Personal: gmail.readonly + calendar
# (creates a "placements" calendar; id stored in DB). Not gmail.modify.
# Personal is optional; PESU-only shortlists still work when PERSONAL is unset.
# Calendar create/update is a no-op when PERSONAL is unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN_PESU=
GOOGLE_REFRESH_TOKEN_PERSONAL=

# M9
CURSOR_WEBHOOK_URL=
CURSOR_WEBHOOK_SECRET=
DRAFT_CALLBACK_SECRET=
PUBLIC_BASE_URL=
