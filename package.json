{
  "name": "pesu-placement-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Personal placement automation: a deterministic watcher for the PESU placement catalog.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=.env --watch app/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "placement:smoke": "node --env-file-if-exists=.env scripts/placement-smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
